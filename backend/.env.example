# Copy this file to backend/.env and fill in real values. backend/.env is git-ignored.
# Format: KEY=value (Java properties syntax)

# ---- Gmail SMTP (required for OTP / verification e-mails) ----
# Use a Google "App Password" (Google Account > Security > 2-Step Verification > App passwords)
SPRING_MAIL_USERNAME=your.address@gmail.com
SPRING_MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ---- Secrets ----
# Generate with:  openssl rand -base64 64
# JWT_SECRET=
DB_PASSWORD=hirejob123

# ---- Company administrator (created/updated on start-up, signs in at the hidden admin portal) ----
# ADMIN_EMAIL=
# min 12 chars, upper + lower + digit + symbol
# ADMIN_PASSWORD=
# Optional: restrict admin portal to these IPs (comma separated)
# ADMIN_ALLOWED_IPS=

# ---- Google Sign-In (OAuth Client ID from Google Cloud Console, type "Web application") ----
# Authorised JavaScript origin: http://localhost:5173
# GOOGLE_CLIENT_ID=

# ---- Optional SMS OTP via Twilio ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---- Production hardening ----
# true when the site is served over HTTPS
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=false
